# core.autocrlf is on here and the tree is CRLF, which is right for the sources. A shell script is
# not: MSYS2's bash reads the carriage returns as part of the command and the build dies on the
# first line. Tools/ffmpeg-build.sh is the one that matters, and any other shell script would want
# the same.
*.sh text eol=lf

# litehtml's sources are LF, and a patch for them in CRLF matches none of their lines.
GeneralsMD/Code/Libraries/Source/litehtml-*.patch text eol=lf

# So are LZH-Light's (the fetched archive), and the same holds for its patch.
GeneralsMD/Code/Libraries/Source/lzhl-*.patch text eol=lf

# So are SDL3's, and the same holds for its patches.
GeneralsMD/Code/Libraries/Source/sdl3-*.patch text eol=lf

# FFmpeg's own files, committed as they came out of its build: no line ending conversion on the
# headers, and the DLLs and import libraries are binary.
GeneralsMD/Code/Libraries/Source/FFmpeg/dist/** -text
GeneralsMD/Code/Libraries/Source/FFmpeg/dist-arm64/** -text

# The build fingerprint's list of tracked files (N1): one form everywhere, whatever autocrlf does.
GeneralsMD/Code/BuildFingerprint.manifest text eol=lf

# Compiled Direct3D 11 programs, recorded by Tools/record-dx11-shaders.ps1: binary, never converted.
GeneralsMD/Code/Data/dx11shaders.shipped -text

# The INI masters are CRLF in every checkout, as autocrlf makes them on Windows. The multiplayer INI CRC
# reads each line with its carriage return (INI::readLine turns it into a space), so a build made from an
# LF checkout computes another CRC and cannot join a Windows player's game. Tools/stage-overlay.sh makes
# them CRLF as well, for a checkout made before this line, whose files git does not rewrite.
GeneralsMD/Code/Data/INI/** text eol=crlf

# The PT-BR edition's localized videos and textures: bytes, never text.
PTBR/payload/**/*.bik binary
PTBR/payload/**/*.BIK binary
PTBR/payload/**/*.dds binary
PTBR/payload/**/*.tga binary
PTBR/payload/**/*.bmp binary
